                                    <engine:VisualElement name="SensorsContent" class="setContent" style="flex-grow: 1;" />
                                </engine:VisualElement>
                            </engine:VisualElement>
                        </engine:VisualElement>
                        <engine:Label tabindex="-1" display-tooltip-when-elided="true" name="LabelBugfix" class="backLine" style="min-height: 100%; max-width: 3px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: -1px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; border-left-width: 0; border-left-color: rgba(103, 180, 201, 0.59); border-right-color: rgba(103, 180, 201, 0.59); border-top-color: rgba(103, 180, 201, 0.59); border-bottom-color: rgba(103, 180, 201, 0.59); width: auto; background-color: rgba(84, 153, 175, 0.59); overflow: hidden; left: auto; height: auto;" />
                        <engine:VisualElement name="AdaptiveTab" class="adaptiveTab" style="flex-grow: 1; flex-direction: column; background-color: rgb(0, 36, 57); color: rgb(0, 0, 0); height: auto;">
                            <engine:VisualElement name="SensorData" class="dataContent" style="width: auto; flex-direction: column; flex-grow: 1; background-color: rgb(16, 53, 73);">
                                <engine:VisualElement name="Header" class="header">
                                    <engine:Label tabindex="-1" text="Inspector" display-tooltip-when-elided="true" name="Title" class="subtitle" style="font-size: 16px;" />
                                </engine:VisualElement>
                                <engine:TextField picking-mode="Ignore" label="Name" name="TextFieldSensorName" tooltip="Name of this State" style="border-right-width: 0; border-left-width: 0; border-top-width: 0; border-bottom-width: 0; border-left-color: rgb(195, 244, 247); border-right-color: rgb(195, 244, 247); border-top-color: rgb(195, 244, 247); border-bottom-color: rgb(195, 244, 247); align-items: stretch; flex-direction: row; justify-content: flex-start; align-self: auto;" />
                                <engine:VisualElement name="SensorProperties" class="properties" style="flex-grow: 1;" />
                            </engine:VisualElement>
