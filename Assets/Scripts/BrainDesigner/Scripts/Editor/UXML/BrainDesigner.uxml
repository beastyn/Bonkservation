                                        <engine:Label tabindex="-1" text="Tasks" display-tooltip-when-elided="true" name="Sensors" style="white-space: nowrap; -unity-text-align: middle-left; text-overflow: ellipsis; font-size: 16px;" />
                                        <engine:VisualElement name="Fill" style="flex-grow: 1; -unity-text-align: middle-center; justify-content: flex-end; margin-bottom: 0; padding-bottom: 0; height: 21px;" />
                                        <engine:Button text="+" display-tooltip-when-elided="true" name="ButtonAddTask" tooltip="Add a new State." class="buttonAddRemove" />
