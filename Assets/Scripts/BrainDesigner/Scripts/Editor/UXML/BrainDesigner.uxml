                                <engine:TextField picking-mode="Ignore" label="Name" name="TextFieldIndicatorName" tooltip="Name of this State" style="border-right-width: 0; border-left-width: 0; border-top-width: 0; border-bottom-width: 0; border-left-color: rgb(195, 244, 247); border-right-color: rgb(195, 244, 247); border-top-color: rgb(195, 244, 247); border-bottom-color: rgb(195, 244, 247); align-items: stretch; flex-direction: row; justify-content: flex-start; align-self: auto;" />
                                <engine:VisualElement name="IndicatorProperties" class="properties" style="flex-grow: 1;" />
                            </engine:VisualElement>
                        </engine:VisualElement>
                    </engine:VisualElement>
                </engine:VisualElement>
                <engine:VisualElement name="TaskGeneratorPanel" style="flex-direction: column; margin-top: 5px; display: flex; height: auto;">
                    <engine:VisualElement name="TasksPanel" class="panel" style="flex-grow: 1; flex-shrink: 1; flex-direction: row; display: flex; border-right-width: 1px;">
                        <engine:VisualElement name="TaskSetsPanel" style="flex-grow: 0; flex-direction: column; background-color: rgb(0, 36, 57); padding-right: 0; padding-top: 5px; padding-bottom: 5px; padding-left: 5px; color: rgb(0, 0, 0); height: auto; width: 200px;">
                            <engine:VisualElement name="TaskListPanel" style="width: auto; flex-direction: column;">
                                <editor:Toolbar name="Toolbar" style="height: 21px; background-color: rgba(60, 60, 60, 0); padding-right: 5px; border-bottom-width: 0; border-right-width: -1px; border-left-color: rgba(120, 204, 226, 0.59); border-right-color: rgba(120, 204, 226, 0.59); border-top-color: rgba(120, 204, 226, 0.59); border-bottom-color: rgba(120, 204, 226, 0.59);">
                                    <engine:VisualElement name="Header" class="header" style="flex-grow: 1; border-left-color: rgba(120, 204, 226, 0.59); border-right-color: rgba(120, 204, 226, 0.59); border-top-color: rgba(120, 204, 226, 0.59); border-bottom-color: rgba(120, 204, 226, 0.59); border-bottom-width: 1px;">
                                        <engine:Label text="SetName" name="Label" />
