                    </engine:VisualElement>
                    <engine:VisualElement name="IndicatorPanel" class="panel" style="flex-grow: 1; width: 50%; flex-shrink: 1; flex-direction: row; margin-left: 5px; display: flex; border-left-width: 1px;">
                        <engine:VisualElement name="IndicatorsSetsPanel" style="flex-grow: 0; flex-direction: column; background-color: rgb(0, 36, 57); padding-right: 0; padding-top: 5px; padding-bottom: 5px; padding-left: 5px; color: rgb(0, 0, 0); border-top-width: 0; border-left-width: 0; border-bottom-width: 1px; border-right-width: 1px; border-left-color: rgba(111, 192, 214, 0.16); border-right-color: rgba(111, 192, 214, 0.16); border-top-color: rgba(111, 192, 214, 0.16); border-bottom-color: rgba(111, 192, 214, 0.16); height: auto; width: 200px;">
                            <engine:VisualElement name="IndicatorsPanel" style="width: auto; flex-direction: column;">
                                <editor:Toolbar name="Toolbar" style="height: 21px; background-color: rgba(60, 60, 60, 0); padding-right: 5px; border-bottom-width: 0; border-right-width: -1px; border-left-color: rgba(120, 204, 226, 0.59); border-right-color: rgba(120, 204, 226, 0.59); border-top-color: rgba(120, 204, 226, 0.59); border-bottom-color: rgba(120, 204, 226, 0.59);">
                                    <engine:VisualElement name="Header" class="header" style="flex-grow: 1; border-left-color: rgba(120, 204, 226, 0.59); border-right-color: rgba(120, 204, 226, 0.59); border-top-color: rgba(120, 204, 226, 0.59); border-bottom-color: rgba(120, 204, 226, 0.59); border-bottom-width: 1px;">
