<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/Scripts/BrainDesigner/Scripts/Editor/USS/BrainDesigner.uss?fileID=7433441132597879392&amp;guid=011b3d9b0dc52854c861a03adc6cb530&amp;type=3#BrainDesigner" />
    <engine:TabView name="TabbedView" class="tabbedView" style="display: flex;">
        <engine:Tab label="Tasks Generator" name="TabTasksGenerator" class="tab">
            <engine:TabView name="ContentTasksGenerator" style="display: flex; flex-direction: column; flex-grow: 0; flex-shrink: 1;">
                <engine:VisualElement name="SensorIndicatorsPanel" style="flex-direction: row; height: auto;">
                    <engine:VisualElement name="SensorsPanel" class="panel" style="flex-grow: 1; width: 50%; flex-shrink: 1; flex-direction: row; display: flex; border-right-width: 1px;">
                        <engine:VisualElement name="SensorsSetsPanel" style="flex-grow: 0; flex-direction: column; background-color: rgb(0, 36, 57); padding-right: 0; padding-top: 5px; padding-bottom: 5px; padding-left: 5px; color: rgb(0, 0, 0); height: auto; width: 200px;">
                            <engine:VisualElement name="SensorsPanel" style="width: auto; flex-direction: column;">
                                <editor:Toolbar name="Toolbar" style="height: 21px; background-color: rgba(60, 60, 60, 0); padding-right: 5px; border-bottom-width: 0; border-right-width: -1px; border-left-color: rgba(120, 204, 226, 0.59); border-right-color: rgba(120, 204, 226, 0.59); border-top-color: rgba(120, 204, 226, 0.59); border-bottom-color: rgba(120, 204, 226, 0.59);">
                                    <engine:VisualElement name="Header" class="header" style="flex-grow: 1; border-top-color: rgba(120, 204, 226, 0.59); border-bottom-color: rgba(120, 204, 226, 0.59); border-bottom-width: 1px; border-left-color: rgba(120, 204, 226, 0.59); border-right-color: rgba(120, 204, 226, 0.59);">
                                        <engine:Label text="SetName" name="Label" />
