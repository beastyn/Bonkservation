                                        <engine:Label tabindex="-1" text="Sensors" display-tooltip-when-elided="true" name="Sensors" style="white-space: nowrap; -unity-text-align: middle-left; text-overflow: ellipsis; font-size: 16px;" />
                                        <engine:VisualElement name="Fill" style="flex-grow: 1; -unity-text-align: middle-center; justify-content: flex-end; margin-bottom: 0; padding-bottom: 0; height: 21px;">
                                            <editor:ToolbarMenu tabindex="-1" display-tooltip-when-elided="true" name="MenuSensorsTypes" text="-" tooltip="All State Sets." class="toolbarMenu" style="-unity-text-align: middle-left; flex-grow: 1; background-color: rgb(5, 18, 26); color: rgb(252, 246, 227); border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgb(11, 177, 254); border-right-color: rgb(11, 177, 254); border-top-color: rgb(11, 177, 254); border-bottom-color: rgb(11, 177, 254); margin-right: 5px;" />
                                        </engine:VisualElement>
