<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Scripts/BrainDesigner/Scripts/Editor/USS/BrainDesigner.uss?fileID=7433441132597879392&amp;guid=011b3d9b0dc52854c861a03adc6cb530&amp;type=3#BrainDesigner" />
    <engine:VisualElement name="Container" class="list-view-item" style="height: 100px; justify-content: center; margin-left: 0; left: 0; right: auto; background-position-x: left -10px; flex-grow: 0; padding-left: 5px; background-size: 300% 100%; width: 200px; border-left-color: rgba(120, 204, 226, 0.59); border-right-color: rgba(120, 204, 226, 0.59); border-top-color: rgba(120, 204, 226, 0.59); border-bottom-color: rgba(120, 204, 226, 0.59); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px;">
        <engine:VisualElement name="Title" class="header">
            <engine:Label tabindex="-1" text="Task Name" display-tooltip-when-elided="true" name="LabelTitle" class="entryTitle" style="font-size: 14px;" />
            <engine:VisualElement name="Spacer" style="flex-grow: 1;" />
        </engine:VisualElement>
        <engine:VisualElement name="LinkedTaskBehaviours" style="flex-grow: 1;" />
        <engine:VisualElement name="ChooseBehaviour" style="flex-grow: 1; justify-content: flex-start;">
            <engine:DropdownField label="Behaviour" name="DropdownBehaviours" style="align-items: center;">
                <engine:Button name="ButtonLinkBehaviour" text="+" emoji-fallback-support="false" class="buttonAddRemove commonText" />
            </engine:DropdownField>
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
